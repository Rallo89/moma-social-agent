# Copia in .env (git-ignored) e valorizza. In CI questi valori vivono nei
# GitHub Secrets del repository, non in un file.

# ── Instagram Graph API ─────────────────────────────────────────────────────
# ID numerico dell'account Instagram Business (non l'handle @nome)
IG_USER_ID=
# Token long-lived: scade dopo 60 giorni, il workflow token-check.yml avvisa
IG_ACCESS_TOKEN=

# ── Hosting immagini (media.backend = "s3") ─────────────────────────────────
MEDIA_BUCKET=
MEDIA_PUBLIC_BASE=https://cdn.esempio.it
AWS_REGION=eu-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Hosting immagini (media.backend = "imgbb") ──────────────────────────────
IMGBB_API_KEY=

# ── Sorgenti dati, se protette da token ─────────────────────────────────────
EVENTS_API_TOKEN=
RESULTS_API_TOKEN=

# ── Supabase ────────────────────────────────────────────────────────────────
# Chiave anon (pubblicabile), con policy RLS di sola lettura sulle tabelle
# usate dai post. NON usare la service_role: scavalca RLS e puo' scrivere.
SUPABASE_KEY=

# ── Canva Connect API (solo per `momasocial canva-sync`) ────────────────────
# Da Developer Portal -> la tua integrazione -> Configuration
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ── Instagram: solo per `momasocial ig-setup` ────────────────────────────────
# Chiave segreta di Instagram, da Casi d'uso > API Instagram > Configurazione
# dell'API con Instagram login. Serve a scambiare il token breve con quello da
# 60 giorni; non la usa nessun altro comando.
IG_APP_SECRET=

# Solo se si passa al percorso Facebook Login (api_host = graph.facebook.com):
# Impostazioni dell'app Meta > Di base.
FB_APP_ID=
FB_APP_SECRET=

# Copertina della Pagina Facebook: token DELLA PAGINA, distinto da Instagram.
FB_PAGE_ID=103801828664136
