{#
  Cornice comune delle card — da "Template Evento Dark" (Claude Design).

  Il disegno e' autoriale: colori, corpi, spaziature e asset vengono
  dall'artboard originale (templates/calendar/) e non si toccano. Qui sta
  tutto quello che le card hanno in comune: fondo, trama, occhiello, blocco
  dati col filo lime, piede. Cambia solo il centro, nel blocco `corpo`.

  L'artboard e' disegnato a 1080 di larghezza. Per qualunque altra dimensione
  si scala l'intero blocco invece di ricalcolare ogni misura: cosi' corpi,
  spaziature e proporzioni restano quelli approvati.

  L'altezza dell'artboard segue le proporzioni richieste (1080x1350 per un 4:5)
  e la scala e' uniforme. Scalare i due assi separatamente sarebbe stato piu'
  corto da scrivere e avrebbe stirato tutto del 25%: caratteri schiacciati,
  loghi deformati e la torta del meta diventata un'ellisse. Su un formato piu'
  alto i millimetri in piu' vanno al centro della card, che e' `flex: 1`;
  testa e piede restano dove il grafico li ha messi.

  Chi la estende:
    evento.html.j2     una serata sola, in grande
    settimana.html.j2  tutte le serate della settimana, in elenco
#}
{% set ART = 1080 %}
{% set ART_H = (ART * height / width)|round|int %}
<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<style>
{% include "_fonts.css.j2" %}

  @page { size: {{ width }}px {{ height }}px; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: {{ width }}px; height: {{ height }}px;
    overflow: hidden; background: #14171a;
    -webkit-font-smoothing: antialiased;
  }
  .scala {
    position: absolute; top: 0; left: 0;
    width: {{ ART }}px; height: {{ ART_H }}px;
    transform: scale({{ width / ART }});
    transform-origin: top left;
  }
  /* Il tema chiaro serve al post delle classifiche, che deve staccarsi dagli
     altri nel feed. Non e' un tema del viewer: e' una scelta editoriale, e
     vale per tutta la card. */
  .art.chiaro { background: #f2f4f0; color: #14171a; }
  .art.chiaro .velo {
    background: linear-gradient(115deg, rgba(242,244,240,0) 42%, #f2f4f0 62%);
  }
  .art.chiaro .trama { opacity: .18; filter: invert(1); }
  .art.chiaro .kicker { color: #6b7280; }
  .art.chiaro .sopratitolo { color: #3f4650; }
  .art.chiaro .voce .dettaglio { color: #6b7280; }
  .art.chiaro .riga .punti { color: #14171a; }
  .art.chiaro .invito .link { color: #3f4650; }
  /* I due loghi sono bianchi o lime su fondo scuro: su carta chiara il primo
     sparirebbe. Si inverte solo quello, che e' monocromatico. */
  .art.chiaro .testa img { filter: invert(1); }

  /* Variante verde per le classifiche generali: il lime del marchio come
     fondo pieno, tutto il resto in nero. Gli accenti lime qui non servono —
     su lime non si vedono — e il loro lavoro lo fa il nero. */
  .art.verde { background: #a9d227; color: #14171a; }
  .art.verde .velo {
    background: linear-gradient(115deg, rgba(169,210,39,0) 42%, #a9d227 62%);
  }
  .art.verde .trama { opacity: .16; filter: invert(1); }
  /* I grigi del tema scuro qui non funzionano: su lime schiariscono invece
     di spegnersi. Si usa il nero trasparente, e non sotto .68 — piu' in la'
     il contrasto scende sotto 4.5:1 e il testo piccolo si perde nel fondo. */
  .art.verde .kicker { color: rgba(20,23,26,.72); }
  .art.verde .sopratitolo { color: rgba(20,23,26,.72); }
  .art.verde .voce .etichetta { color: #14171a; }
  .art.verde .voce .dettaglio { color: rgba(20,23,26,.72); }
  .art.verde .filo { background: #14171a; }
  .art.verde .riga .pos { color: rgba(20,23,26,.68); }
  .art.verde .riga .punti { color: #14171a; }
  .art.verde .invito .titolino { color: #14171a; }
  .art.verde .invito .link { color: rgba(20,23,26,.72); }
  /* Il badge era lime su scuro: sul fondo lime resterebbe solo il testo.
     Scambiando i due colori la targhetta resta una targhetta. */
  .art.verde .badge { background: #14171a; color: #a9d227; }
  /* Un logo e' bianco, l'altro e' lime: su questo fondo il primo abbaglia e
     il secondo sparisce. brightness(0) li porta entrambi al nero pieno senza
     toccare la trasparenza, cosa che invert(1) non farebbe (il lime
     diventerebbe viola). */
  .art.verde .testa img,
  .art.verde .piede img.partner { filter: brightness(0); }
  .art {
    width: {{ ART }}px; height: {{ ART_H }}px; position: relative; overflow: hidden;
    background: #14171a; color: #f2f4f0;
    display: flex; flex-direction: column;
    font-family: 'Barlow Condensed', sans-serif;
  }
  .trama {
    position: absolute; top: -90px; left: -80px; height: 900px;
    opacity: .3; transform: rotate(-6deg);
  }
  .velo {
    position: absolute; inset: 0;
    background: linear-gradient(115deg, rgba(20,23,26,0) 42%, #14171a 62%);
  }

  .testa {
    position: relative; padding: 58px 64px 0;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 24px;
  }
  .testa img { width: 168px; }
  .kicker {
    text-align: right; font-family: 'JetBrains Mono', monospace;
    font-size: 15px; line-height: 2; letter-spacing: .2em;
    text-transform: uppercase; color: #8b9490;
  }

  .corpo {
    position: relative; flex: 1; padding: 0 64px;
    display: flex; flex-direction: column; justify-content: center; gap: 30px;
    min-height: 0;
  }
  .badge {
    align-self: flex-start; background: #a9d227; color: #14171a;
    font-weight: 700; font-size: 30px; letter-spacing: .2em;
    text-transform: uppercase; padding: 9px 22px; white-space: nowrap;
  }
  /* Prima riga del titolo: il nome della lega, subordinato alla tappa. */
  .sopratitolo {
    font-weight: 700; font-size: 44px; letter-spacing: .06em;
    text-transform: uppercase; white-space: nowrap;
    color: #d5dad6; margin-bottom: 6px;
  }
  /* Dove il titolo non e' la notizia — una classifica, il meta — cede spazio
     al contenuto. */
  .titolo.classifica { font-size: 110px; }
  .titolo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 190px;
    line-height: .82; letter-spacing: .005em; text-wrap: balance;
  }
  .dati { display: flex; align-items: stretch; gap: 34px; margin-top: 8px; }
  .filo { width: 3px; background: #a9d227; }
  .voci { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .voce { display: flex; flex-direction: column; }
  .voce .etichetta {
    font-family: 'JetBrains Mono', monospace; font-size: 14px;
    letter-spacing: .24em; text-transform: uppercase; color: #a9d227;
  }
  .voce .valore {
    font-weight: 600; font-size: 46px; letter-spacing: .03em;
    text-transform: uppercase; white-space: nowrap;
  }
  /* Seconda riga di una voce: l'indirizzo sotto il nome della sede. Piu'
     piccolo e piu' spento, cosi' non compete con il dato principale. */
  .voce .dettaglio {
    font-weight: 600; font-size: 28px; letter-spacing: .04em;
    text-transform: uppercase; white-space: nowrap;
    color: #8b9490; margin-top: 2px;
  }

  .piede {
    position: relative; padding: 0 64px 46px;
    display: flex; align-items: center; justify-content: space-between; gap: 28px;
  }
  .iscrizioni { display: flex; align-items: center; gap: 22px; }
  .qr {
    width: 128px; height: 128px; background: #f2f4f0;
    display: grid; place-items: center; overflow: hidden;
    font-family: 'JetBrains Mono', monospace; font-size: 11px; line-height: 1.5;
    text-align: center; color: #14171a; letter-spacing: .06em;
  }
  .qr img { width: 128px; height: 128px; }
  .invito { display: flex; flex-direction: column; gap: 4px; }
  .invito .titolino {
    font-weight: 700; font-size: 32px; letter-spacing: .08em;
    text-transform: uppercase; color: #a9d227;
  }
  .invito .link {
    font-family: 'JetBrains Mono', monospace; font-size: 17px;
    color: #d5dad6; white-space: nowrap;
  }
  .piede img.partner { height: 84px; }
{% block stili %}{% endblock %}
</style>
</head>
<body>
{# I temi ammessi si elencano qui: `tema` viene da config e senza questa
   lista finirebbe come classe CSS qualsiasi cosa ci sia scritto. #}
{% set temi = ["chiaro", "verde"] %}
<div class="scala"><div class="art{% if tema|default("") in temi %} {{ tema }}{% endif %}">
  {% set trama = "templates/images/assets/triangoli.png"|asset %}
  {% if trama %}<img class="trama" src="{{ trama }}" alt="">{% endif %}
  <div class="velo"></div>

  <div class="testa">
    {% set logo = "templates/images/assets/logo-modena-magic.png"|asset %}
    {% if logo %}<img src="{{ logo }}" alt="Modena Magic">{% else %}<div></div>{% endif %}
    <div class="kicker">{{ kicker_1 }}{% if kicker_2 %}<br>{{ kicker_2 }}{% endif %}</div>
  </div>

  <div class="corpo" id="corpo">
{% block corpo %}{% endblock %}
  </div>

  <div class="piede">
    <div class="iscrizioni">
      {# Il QR compare solo se ce n'e' uno vero: un riquadro con scritto "QR"
         al posto del codice occupa spazio senza servire a niente. #}
      {% set qr = qr_image|default("")|asset %}
      {% if qr %}<div class="qr"><img src="{{ qr }}" alt=""></div>{% endif %}
      <div class="invito">
        <span class="titolino">{{ invito|default("Iscriviti") }}</span>
        <span class="link" data-fit="12">{{ link }}</span>
      </div>
    </div>
    {% set partner = "templates/images/assets/unocritico.png"|asset %}
    {% if partner %}<img class="partner" src="{{ partner }}" alt="Uno Critico">{% endif %}
  </div>
</div></div>
<script>
/*
  Rete di sicurezza: rimpicciolisce i testi che il disegno vuole su una riga
  sola, ma solo se non ci stanno.

  I corpi scritti nel CSS sono quelli approvati e restano tali per i titoli
  di lunghezza normale: "Giovedì Modern" e "Mercoledì Commander" escono
  entrambi a 190px, identici all'artboard. Serve per l'eccezione — un nome
  torneo piu' lungo del previsto — dove una parola tracimerebbe fuori dalla
  slide senza che nessuno se ne accorga prima della pubblicazione.

  Gira in entrambi i backend, che sono due browser; lo screenshot viene preso
  dopo, a font caricati.
*/
(function () {
  function larghezzaUtile(el) {
    var padre = el.parentElement, stile = getComputedStyle(padre);
    // clientWidth comprende il padding: va tolto, o il confronto e' falsato.
    return padre.clientWidth
      - parseFloat(stile.paddingLeft) - parseFloat(stile.paddingRight);
  }
  function adatta(el) {
    var minimo = parseFloat(el.dataset.fit) || 12;
    var corpo = parseFloat(getComputedStyle(el).fontSize);
    var utile = larghezzaUtile(el);
    // Due tracimazioni diverse: una parola piu' larga di un blocco che si
    // stira, e un blocco a larghezza contenuto piu' largo dello spazio.
    function deborda() {
      return el.scrollWidth > el.clientWidth + 1 || el.offsetWidth > utile + 1;
    }
    while (corpo > minimo && deborda()) {
      corpo -= 2;
      el.style.fontSize = corpo + 'px';
    }
  }
  function adattaAltezza(el) {
    // Un titolo di tre parole entra in larghezza ma allunga il blocco
    // centrale finche' scavalca il logo in alto e il piede in basso. Qui si
    // guarda il contenitore, non il testo.
    var contenitore = document.getElementById(el.dataset.fitAltezza);
    if (!contenitore) return;
    var minimo = parseFloat(el.dataset.fit) || 12;
    var corpo = parseFloat(getComputedStyle(el).fontSize);
    while (corpo > minimo
           && contenitore.scrollHeight > contenitore.clientHeight + 1) {
      corpo -= 4;
      el.style.fontSize = corpo + 'px';
    }
  }
  function passa() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-fit]'), adatta);
    Array.prototype.forEach.call(
      document.querySelectorAll('[data-fit-altezza]'), adattaAltezza);
    document.documentElement.setAttribute('data-adattato', '1');
  }
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(passa);
  else window.addEventListener('load', passa);
})();
</script>
</body>
</html>
