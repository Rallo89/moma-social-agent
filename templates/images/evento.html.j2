{#
  Card di una serata: badge del formato, titolo grande, blocco dati.

  Slot (stessi nomi del file di istruzioni del grafico):
    kicker_1 kicker_2 · badge · sopratitolo · titolo · voci · invito · link
#}
{% extends "_carta.html.j2" %}
{% block corpo %}
    {% if badge %}<div class="badge" data-fit="20">{{ badge }}</div>{% endif %}
    <div class="blocco-titolo">
      {% if sopratitolo %}
      <div class="sopratitolo" data-fit="24">{{ sopratitolo }}</div>
      {% endif %}
      <div class="titolo" data-fit="100" data-fit-altezza="corpo">{{ titolo }}</div>
    </div>
    <div class="dati">
      <div class="filo"></div>
      <div class="voci">
        {% for voce in voci %}
        {% if voce.valore %}
        <div class="voce">
          <span class="etichetta">{{ voce.etichetta }}</span>
          <span class="valore" data-fit="30">{{ voce.valore }}</span>
          {% if voce.get("dettaglio") %}
          <span class="dettaglio" data-fit="18">{{ voce.get("dettaglio") }}</span>
          {% endif %}
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </div>
{% endblock %}
